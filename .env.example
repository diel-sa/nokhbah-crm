# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=""
# Example: postgresql://user:pass@host:5432/crm?schema=public
TEST_DATABASE_URL=""
DIRECT_DATABASE_URL=""

# ── Session / auth ───────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""
ALLOWED_SIGN_IN=""
# Example: nokhbah.sa,nokhbah.diel@gmail.com
AUTH_COOKIE_DOMAIN=""
# Example: .nokhbah.sa

# ── Microsoft Entra (primary sign-in + Outlook mail/calendar sync) ───────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# ── Google OAuth (backup sign-in + Gmail/Calendar sync) ──────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Origins ──────────────────────────────────────────────────────────────────
APP_URL=""
# Example: https://crm.nokhbah.sa
API_URL=""
# Example: https://api.crm.nokhbah.sa
AGENT_URL=""
AGENT_PORT="2000"

# ── Agent bridge (same value in app + api + agent) ───────────────────────────
AGENT_BRIDGE_SECRET=""

# ── Agent capabilities ───────────────────────────────────────────────────────
PERPLEXITY_API_KEY=""
GITHUB_TOKEN=""
AI_GATEWAY_API_KEY=""
BLOB_READ_WRITE_TOKEN=""

# ── Operations ───────────────────────────────────────────────────────────────
CRON_SECRET=""
REDIS_URL=""

# ── Telemetry ────────────────────────────────────────────────────────────────
# Leave unset to send anonymised telemetry to your own PostHog project.
# Set to "1" to disable telemetry completely.
# CRM_TELEMETRY_DISABLED="1"
